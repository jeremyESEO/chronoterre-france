{"visibility": "domain", "fields": [{"name": "geo_point_2d", "description": null, "annotations": {}, "label": "Geo Point", "type": "geo_point_2d"}, {"name": "geo_shape", "description": null, "annotations": {}, "label": "Geo Shape", "type": "geo_shape"}, {"name": "gid", "description": "Cl\u00e9 primaire", "annotations": {"facetsort": "-count"}, "label": "gid", "type": "int"}, {"name": "geom_err", "description": "Code d'erreur g\u00e9om\u00e9trique : \nListe des valeurs possibles : \n9999 : Polygone compose et / ou \u00e0 sections multiples\n9998 : Lin\u00e9aire compose et / ou \u00e0 sections multiples\n9996 : La g\u00e9om\u00e9trie contient des informations LRS\n9995 : Nombre de dimensions diff\u00e9rent de 2 ou 3\n9994 : Pr\u00e9sence d'un arc de cercle\n9000 : Erreur autre\n13343 : Polygone de moins de 4 points\n13349 : Polygone papillon\n13350 : Deux \u00e9l\u00e9ments d'un polygone archipel se touchent\n13351 : Deux \u00e9l\u00e9ments d'un polygone archipel  se touchent\n13356 : Point double\n13366 : Combinaison invalide d'int\u00e9rieur / ext\u00e9rieur d'un polygone\n13367 : Orientation invalide d'int\u00e9rieur / ext\u00e9rieur d'un polygone", "annotations": {}, "label": "geom_err", "type": "text"}, {"name": "ident", "description": "Identifiant", "annotations": {}, "label": "ident", "type": "text"}, {"name": "cdate", "description": "Date de cr\u00e9ation", "annotations": {"facetsort": "-count"}, "label": "cdate", "type": "datetime"}, {"name": "mdate", "description": "Date de modification", "annotations": {"facetsort": "-count"}, "label": "mdate", "type": "datetime"}, {"name": "alea", "description": "Al\u00e9a : \nListe des valeurs possibles : \nFAIBLE : Faible\nMOYEN : Moyen\nFORT : Fort", "annotations": {"facet": true, "disjunctive": true}, "label": "alea", "type": "text"}], "dataset_id": "ri_alearga_s", "dataset_uid": "da_dt1033", "has_records": true, "features": ["analyze", "timeserie", "geo", "custom_view"], "attachments": [], "alternative_exports": [], "data_visible": true, "metas": {"dcat": {"created": null, "issued": null, "creator": null, "contributor": null, "contact_name": null, "contact_email": null, "accrualperiodicity": null, "spatial": null, "temporal": null, "granularity": null, "dataquality": null, "publisher_type": null, "conforms_to": null, "temporal_coverage_start": null, "temporal_coverage_end": null, "accessRights": null, "relation": null}, "inspire": {"theme": ["sinistre", "maison indivuelle", "retrait", "gonflement", "argiles", "opendata", "donn\u00e9es ouvertes", "RI_ALEARGA_S", "RI_ALEARGA"], "type": null, "file_identifier": "2012ec03-1e0b-4362-8383-b2557f78672e", "hierarchy_level": null, "hierarchy_level_name": null, "spatial_resolution": null, "topologic_consistency": null, "contact_individual_name": "Direction Developpement Numerique du Territoire ADG TND", "contact_position": null, "contact_address": null, "contact_email": null, "identification_purpose": "Ce jeu de donn\u00e9es est mobilis\u00e9 dans le cadre de la construction d'un observatoire de la vuln\u00e9rabilit\u00e9 du territoire, pour le calcul d'indicateurs d'exposition \u00e0 des al\u00e9as", "extend_description": "D\u00e9partement de la Gironde", "extend_bounding_box_westbound_longitude": "-0.8835", "extend_bounding_box_eastbound_longitude": "-0.44377", "extend_bounding_box_southbound_latitude": "44.730085", "extend_bounding_box_northbound_latitude": "45.04764"}, "default": {"title": "Al\u00e9a retrait/gonflement des argiles", "description": "       <div class=\"dico\"> <a class=\"ods-button dico-button\" href=\"https://data.bordeaux-metropole.fr/dicopub/#/dico#ri_alearga_s\" target=\"_blank\">     <div>      <div class=\"dico-img-div\">       <img alt=\"picto dictionnaire public\" class=\"dico-img\" src=\"/assets/theme_image/dico_big.png\"/>      </div><small class=\"dico-lib\">Dictionnaire Public</small>     </div></a>   </div>   <br>   <p>Ce jeu de donn\u00e9es pr\u00e9sente, sous la forme d'objets surfaciques, les risques d'al\u00e9a retrait/gonflement des argiles sur le territoire Girondin.</p>   <hr id=\"horizontalrule\"/>   <p> Ce jeu de donn\u00e9es est disponible dans un format additionnel :\u00a0 \u00a0\u00a0<br> </p>   <p> <a class=\"ods-button\" href=\"https://fr.ftp.opendatasoft.com/scnbdx/DWG/RI_ALEARGA_S.dwg\"> T\u00e9l\u00e9chargement au format AutoCAD DWG </a> </p>  ", "theme": ["Observation / connaissance du territoire"], "keyword": ["environnement", "data-gouv", "risque", "nature", "mouvement", "terrain", "argile"], "license": "Licence Ouverte", "license_url": "https://www.etalab.gouv.fr/wp-content/uploads/2014/05/Licence_Ouverte.pdf", "language": "fr", "metadata_languages": ["fr"], "timezone": null, "modified": "2026-09-25T03:45:50+00:00", "modified_updates_on_metadata_change": false, "modified_updates_on_data_change": true, "data_processed": "2026-09-25T03:45:50+00:00", "metadata_processed": "2026-09-25T03:45:50.666000+00:00", "geographic_reference": ["fr_60_33"], "geographic_reference_auto": false, "territory": ["Gironde"], "geometry_types": ["MultiPolygon", "Polygon"], "bbox": {"type": "Feature", "geometry": {"coordinates": [[[-0.4567108768969774, 45.03841078374535], [-0.834070360288024, 45.03841078374535], [-0.834070360288024, 44.74168017972261], [-0.4567108768969774, 44.74168017972261], [-0.4567108768969774, 45.03841078374535]]], "type": "Polygon"}, "properties": {}}, "publisher": "Bureau de Recherches G\u00e9ologiques et Mini\u00e8res", "references": null, "records_count": 127, "attributions": null, "source_domain": null, "source_domain_title": null, "source_domain_address": null, "source_dataset": null, "shared_catalog": null, "federated": false, "parent_domain": null, "update_frequency": null}, "custom": {"frequence": "Quotidienne", "periodicity": "Irr\u00e9guli\u00e8re", "cycle": "Finalis\u00e9"}, "pigma": {"identifiant-pigma": null, "lien-pigma": "https://www.pigma.org/geonetwork/srv/fre/catalog.search#/metadata/2012ec03-1e0b-4362-8383-b2557f78672e", "origine"