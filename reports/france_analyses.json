  {
    "id": "01",
    "question": "Combien de communes ont une fiche climatique ?",
    "sql": "SELECT (SELECT count(*) FROM commune) communes,(SELECT count(*) FROM climate_place) fiches,round(100.0*(SELECT count(*) FROM climate_place)/(SELECT count(*) FROM commune),2) couverture_pct",
    "rows": [
      {
        "communes": 34969,
        "fiches": 34938,
        "couverture_pct": 99.91
      }
    ],
    "seconds": 0.0059,
    "interpretation": "Couverture des fiches, pas exhaustivité des indicateurs ni précision à une adresse."
  },
