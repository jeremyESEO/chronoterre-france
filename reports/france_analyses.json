  {
    "id": "05",
    "question": "Quelle évolution publiée entre 2030 et 2100 ?",
    "sql": "WITH v AS (SELECT commune_code,period_id,value,LAG(value) OVER(PARTITION BY commune_code ORDER BY CAST(period_id AS INTEGER)) preceding FROM climate_value WHERE indicator_id='S1' AND season='annuel' AND period_id IN ('2030','2100')) SELECT c.name,v.value jours_2100,round(v.value-v.preceding,2) difference_2030_2100 FROM v JOIN commune c ON c.code=v.commune_code WHERE period_id='2100' AND c.code IN ('75056','17300','13004','2A004','97411')",
    "rows": [
      {
        "name": "Arles",
        "jours_2100": 16.3,
        "difference_2030_2100": 13.1
      },
      {
        "name": "La Rochelle",
        "jours_2100": 6.55,
        "difference_2030_2100": 5.3
      },
      {
        "name": "Ajaccio",
        "jours_2100": 5.45,
        "difference_2030_2100": 4.3
      },
      {
        "name": "Paris",
        "jours_2100": 8.45,
        "difference_2030_2100": 6.15
      },
      {
        "name": "Saint-Denis",
        "jours_2100": 0.0,
        "difference_2030_2100": 0.0
      }
    ],
    "seconds": 0.2136,
    "interpretation": "Différence entre niveaux publiés, pas prédiction annuelle ni interpolation."
  },
